{
    "name": "boa/theme",
    "description": "Customizable BOA design system for Laravel — brand mark, semantic color tokens, typography, Tailwind CSS v4 theme, and admin settings panel.",
    "type": "library",
    "license": "MIT",
    "version": "0.2.1",
    "keywords": [
        "laravel",
        "theme",
        "design-system",
        "tailwind",
        "boa",
        "settings"
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/events": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/validation": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Boa\\Theme\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Boa\\Theme\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Boa\\Theme\\BoaThemeServiceProvider"
            ],
            "aliases": {
                "BoaTheme": "Boa\\Theme\\Facades\\BoaTheme"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "test:unit": "pest --testsuite=Unit",
        "test:feature": "pest --testsuite=Feature"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
